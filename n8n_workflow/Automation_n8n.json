    {
      "parameters": {
        "promptType": "define",
        "text": "=You are the Main QA Manager Agent.\n\nYour job is to decide which specialist agent should perform the task.\n\nAvailable tools:\n\n1. QA Analysis Agent\n2. Bug Report Agent\n3. Notification Agent\n\nAlways use the appropriate tool based on the user's request.\nUser request fields:  \nrepository: {{ $json.body.repository }}\nstatus: {{ $json.body.status }}\nrun_ id:{{ $json.body.run_id }}\nplaywrightLogs: {{ $json.body.playWrightLogs }}\nYou are the Main QA Orchestrator.\n\nWhen Playwright logs are received:\n\n1. Call the QA Analysis Agent to analyze the failure.\n2. After receiving its response, call the Bug Report Agent to create a professional bug report.\n3. After the bug report is created, call the Notification Agent to email the report.\n\nAlways execute all three agents in this order.\nDo not stop after the first agent.\n",
        "options": {}
      },
      "id": "c97fd5fb-adb8-4fa1-a669-6b6ba2ec8c1a",
      "name": "Main AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
