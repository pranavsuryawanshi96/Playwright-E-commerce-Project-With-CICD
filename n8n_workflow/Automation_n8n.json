      "parameters": {
        "toolDescription": "QA Analysis Agent",
        "text": "You are a QA Analysis Agent.\n\nAnalyze Playwright logs.\n\nFind:\n\n- Root Cause\n- Failure Reason\n- Possible Fix\n\nReturn the result in clear English.",
        "options": {}
      },
